{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "工位",
  "mainBinaryName": "gongwei",
  "version": "0.1.0",
  "identifier": "com.ben.gongwei",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "工位",
        "width": 1120,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
